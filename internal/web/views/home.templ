package views

templ Home() {
	<!doctype html>
	<html lang="en" class="bg-[#0a0a0a] text-[#e8e8e8]">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Meil</title>
			<link rel="stylesheet" href="/assets/css/output.css"/>
		</head>
		<body class="min-h-screen bg-[#0a0a0a] font-sans text-[#e8e8e8] antialiased">
			<main class="mx-auto flex min-h-screen max-w-5xl items-center px-6 py-16">
				<section class="space-y-6 border border-[#222] bg-[#141414] p-8">
					<p class="font-mono text-sm uppercase tracking-[0.3em] text-[#4ad1c2]">email-auth monitoring</p>
					<div class="space-y-3">
						<h1 class="text-5xl font-semibold tracking-tight">meil</h1>
						<p class="max-w-2xl text-lg leading-8 text-[#9a9a9a]">Monitor SPF, DKIM, DMARC, and BIMI records for drift before mail deliverability breaks.</p>
					</div>
				</section>
			</main>
		</body>
	</html>
}
