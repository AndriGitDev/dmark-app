package views

import (
	"github.com/AndriGitDev/meil/internal/domains"
	"github.com/AndriGitDev/meil/internal/scanner"
)

templ Home() {
	<!doctype html>
	<html lang="en" class="bg-[#0a0a0a] text-[#e8e8e8]">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Meil - Email-auth monitoring</title>
			<meta name="description" content="Monitor SPF, DKIM, DMARC, and BIMI records for drift before email deliverability breaks."/>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
			<script defer src="/assets/js/alpine.min.js"></script>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<div class="pointer-events-none fixed inset-0 overflow-hidden">
				<div class="absolute left-1/2 top-0 h-[34rem] w-[34rem] -translate-x-1/2 rounded-full bg-accent/10 blur-3xl"></div>
				<div class="absolute right-0 top-1/3 h-80 w-80 rounded-full bg-warn/10 blur-3xl"></div>
			</div>
			<main class="relative mx-auto max-w-7xl px-5 py-6 sm:px-8 lg:px-10">
				<header class="flex items-center justify-between border-b border-white/10 pb-5">
					<a href="/" class="flex items-center gap-3" aria-label="Meil home">
						<span class="grid h-9 w-9 place-items-center border border-accent/40 bg-accent/10 font-mono text-sm font-semibold text-accent">m</span>
						<span class="text-lg font-semibold tracking-tight">meil</span>
					</a>
					<nav class="hidden items-center gap-8 text-sm text-muted md:flex" aria-label="Primary navigation">
						<a class="transition hover:text-foreground" href="#checks">Checks</a>
						<a class="transition hover:text-foreground" href="#preview">Preview</a>
						<a class="transition hover:text-foreground" href="#reporter">Reporter</a>
					</nav>
				</header>

				<section class="grid gap-12 py-16 lg:grid-cols-[1.02fr_0.98fr] lg:items-center lg:py-24" x-data="{ checked: false, domain: 'northstar.dev' }">
					<div class="max-w-3xl space-y-8">
						<div class="inline-flex items-center gap-3 border border-white/10 bg-white/[0.03] px-3 py-2 font-mono text-xs uppercase tracking-[0.24em] text-accent">
							<span class="h-2 w-2 rounded-full bg-accent shadow-[0_0_18px_rgba(74,209,194,0.9)]"></span>
							Email-auth drift monitoring
						</div>
						<div class="space-y-5">
							<h1 class="max-w-4xl text-5xl font-semibold tracking-[-0.06em] text-white sm:text-6xl lg:text-7xl">Know when your domain stops looking trustworthy.</h1>
							<p class="max-w-2xl text-lg leading-8 text-muted sm:text-xl sm:leading-9">Meil watches SPF, DKIM, DMARC, and BIMI records for drift so technical operators can catch authentication failures before deliverability, brand trust, or customer replies break.</p>
						</div>
						<form method="post" action="/check" class="grid max-w-2xl gap-3 border border-white/10 bg-card/80 p-2 shadow-2xl shadow-black/30 sm:grid-cols-[1fr_auto]">
							<label class="sr-only" for="domain">Domain</label>
							<input id="domain" name="domain" type="text" class="min-h-14 bg-transparent px-4 font-mono text-base text-white outline-none placeholder:text-muted/60" placeholder="yourdomain.com" autocomplete="off"/>
							<button type="submit" class="min-h-14 bg-accent px-6 font-mono text-sm font-semibold uppercase tracking-[0.18em] text-black transition hover:bg-white">Check domain</button>
						</form>
						<div class="grid gap-3 text-sm text-muted sm:grid-cols-3">
							<p><span class="font-mono text-accent">01</span> DNS posture snapshot</p>
							<p><span class="font-mono text-accent">02</span> Drift detection</p>
							<p><span class="font-mono text-accent">03</span> Alert-ready history</p>
						</div>
					</div>

					<section id="preview" class="border border-white/10 bg-[#101010]/95 p-4 shadow-2xl shadow-black/40 sm:p-6" aria-label="Static domain report preview">
						<div class="mb-5 flex items-start justify-between gap-4 border-b border-white/10 pb-5">
							<div>
								<p class="font-mono text-xs uppercase tracking-[0.24em] text-muted">Static report preview</p>
								<h2 class="mt-2 text-2xl font-semibold text-white" x-text="checked && domain ? domain : 'northstar.dev'">northstar.dev</h2>
							</div>
							<div class="border border-accent/30 bg-accent/10 px-3 py-2 text-right">
								<p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Healthy</p>
								<p class="text-2xl font-semibold text-white">92</p>
							</div>
						</div>
						<div class="grid gap-3 sm:grid-cols-2">
							@checkCard("SPF", "Pass", "1 authorized sender set", "text-accent", "border-accent/30")
							@checkCard("DKIM", "Pass", "2 selectors observed", "text-accent", "border-accent/30")
							@checkCard("DMARC", "Watch", "Policy is p=none", "text-warn", "border-warn/30")
							@checkCard("BIMI", "Missing", "No assertion record", "text-muted", "border-white/10")
						</div>
						<div class="mt-5 space-y-3 border border-white/10 bg-black/30 p-4">
							<div class="flex items-center justify-between gap-4">
								<p class="font-mono text-xs uppercase tracking-[0.22em] text-muted">Drift timeline</p>
								<p class="font-mono text-xs text-accent">Last 14 days</p>
							</div>
							<div class="grid grid-cols-[repeat(14,minmax(0,1fr))] gap-1" aria-hidden="true">
								<div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-warn/50"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div>
							</div>
							<p class="text-sm leading-6 text-muted">DMARC policy relaxed seven days ago. Meil keeps the change visible instead of letting it disappear into DNS history.</p>
						</div>
					</section>
				</section>

				<section id="checks" class="grid gap-4 border-y border-white/10 py-12 md:grid-cols-4">
					@featureCard("SPF", "Detect include-chain changes, missing senders, and soft-fail posture before mail starts bouncing.")
					@featureCard("DKIM", "Track selector presence and key drift across the domains that sign your outbound mail.")
					@featureCard("DMARC", "Watch policy, alignment, rua/ruf targets, and enforcement changes with operator-friendly context.")
					@featureCard("BIMI", "Keep brand indicators visible as part of the same authentication posture, not a forgotten DNS extra.")
				</section>

				<section id="reporter" class="grid gap-8 py-16 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
					<div class="space-y-4">
						<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">Checker now, Reporter later</p>
						<h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">Start with DNS truth. Grow into sender attribution.</h2>
					</div>
					<div class="grid gap-4 sm:grid-cols-2">
						@roadmapCard("Now", "Checker monitors the public records that decide whether receivers should trust your domain.")
						@roadmapCard("Later", "Reporter will ingest DMARC aggregate reports and show who is sending mail as you.")
					</div>
				</section>
			</main>
		</body>
	</html>
}

templ CheckResult(result scanner.Result) {
	<!doctype html>
	<html lang="en" class="bg-[#0a0a0a] text-[#e8e8e8]">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ result.Domain } - Meil checker</title>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<main class="mx-auto max-w-7xl px-5 py-6 sm:px-8 lg:px-10">
				<header class="flex items-center justify-between border-b border-white/10 pb-5">
					<a href="/" class="flex items-center gap-3" aria-label="Meil home">
						<span class="grid h-9 w-9 place-items-center border border-accent/40 bg-accent/10 font-mono text-sm font-semibold text-accent">m</span>
						<span class="text-lg font-semibold tracking-tight">meil</span>
					</a>
					<a class="font-mono text-xs uppercase tracking-[0.2em] text-accent" href="/">New check</a>
				</header>

				<section class="space-y-8 py-12">
					<div class="space-y-4">
						<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">Live DNS posture</p>
						<h1 class="text-5xl font-semibold tracking-[-0.06em] text-white">{ result.Domain }</h1>
						<p class="max-w-2xl text-lg leading-8 text-muted">Current public SPF, DKIM, DMARC, and BIMI records. Missing DKIM means Meil did not find a key across common selectors; registered users will be able to add custom selectors later.</p>
					</div>

					<div class="grid gap-4 md:grid-cols-4">
						@checkResultCard(result.SPF)
						@checkResultCard(result.DKIM)
						@checkResultCard(result.DMARC)
						@checkResultCard(result.BIMI)
					</div>
				</section>
			</main>
		</body>
	</html>
}

templ checkResultCard(check scanner.CheckResult) {
	<article class="border border-white/10 bg-card p-5">
		<div class="flex items-center justify-between gap-3">
			<p class="font-mono text-sm font-semibold text-white">{ check.Name }</p>
			<p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">{ string(check.Status) }</p>
		</div>
		<p class="mt-4 text-sm leading-6 text-muted">{ check.Message }</p>
		if check.Record != "" {
			<pre class="mt-4 overflow-hidden border border-white/10 bg-black/30 p-4 text-xs leading-6 text-muted">{ check.Record }</pre>
		}
	</article>
}

templ Login() {
	<!doctype html>
	<html lang="en" class="bg-[#0a0a0a] text-[#e8e8e8]">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Sign in - Meil</title>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<main class="mx-auto grid min-h-screen max-w-xl place-items-center px-5 py-12">
				<section class="w-full border border-white/10 bg-card p-8">
					<a href="/" class="font-mono text-xs uppercase tracking-[0.2em] text-accent">meil</a>
					<h1 class="mt-6 text-4xl font-semibold tracking-[-0.05em] text-white">Sign in with email</h1>
					<p class="mt-4 text-sm leading-6 text-muted">Enter your email and Meil will send a one-time magic link.</p>
					<form method="post" action="/login" class="mt-8 grid gap-3">
						<label class="sr-only" for="email">Email</label>
						<input id="email" name="email" type="email" required class="min-h-14 border border-white/10 bg-black/30 px-4 font-mono text-base text-white outline-none placeholder:text-muted/60" placeholder="you@example.com" autocomplete="email"/>
						<button type="submit" class="min-h-14 bg-accent px-6 font-mono text-sm font-semibold uppercase tracking-[0.18em] text-black transition hover:bg-white">Send magic link</button>
					</form>
				</section>
			</main>
		</body>
	</html>
}

templ LoginSent(email string) {
	<!doctype html>
	<html lang="en" class="bg-[#0a0a0a] text-[#e8e8e8]">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Check your email - Meil</title>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<main class="mx-auto grid min-h-screen max-w-xl place-items-center px-5 py-12">
				<section class="w-full border border-white/10 bg-card p-8">
					<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">Magic link sent</p>
					<h1 class="mt-6 text-4xl font-semibold tracking-[-0.05em] text-white">Check your email</h1>
					<p class="mt-4 text-sm leading-6 text-muted">A one-time sign-in link was sent to { email }. It expires shortly and can only be used once.</p>
				</section>
			</main>
		</body>
	</html>
}

templ AppDomains(email string, saved []domains.Domain) {
	<!doctype html>
	<html lang="en" class="bg-[#0a0a0a] text-[#e8e8e8]">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Saved domains - Meil</title>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<main class="mx-auto max-w-6xl px-5 py-6 sm:px-8 lg:px-10">
				<header class="flex items-center justify-between border-b border-white/10 pb-5">
					<a href="/" class="flex items-center gap-3" aria-label="Meil home">
						<span class="grid h-9 w-9 place-items-center border border-accent/40 bg-accent/10 font-mono text-sm font-semibold text-accent">m</span>
						<span class="text-lg font-semibold tracking-tight">meil</span>
					</a>
					<form method="post" action="/logout">
						<button class="font-mono text-xs uppercase tracking-[0.2em] text-accent" type="submit">Sign out</button>
					</form>
				</header>
				<section class="space-y-8 py-12">
					<div class="space-y-3">
						<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">Signed in as { email }</p>
						<h1 class="text-5xl font-semibold tracking-[-0.06em] text-white">Saved domains</h1>
						<p class="max-w-2xl text-lg leading-8 text-muted">Save domains and revisit their latest SPF, DKIM, DMARC, and BIMI posture.</p>
					</div>
					<form method="post" action="/app/domains" class="grid max-w-2xl gap-3 border border-white/10 bg-card/80 p-2 sm:grid-cols-[1fr_auto]">
						<label class="sr-only" for="domain">Domain</label>
						<input id="domain" name="domain" type="text" class="min-h-14 bg-transparent px-4 font-mono text-base text-white outline-none placeholder:text-muted/60" placeholder="yourdomain.com" autocomplete="off"/>
						<button type="submit" class="min-h-14 bg-accent px-6 font-mono text-sm font-semibold uppercase tracking-[0.18em] text-black transition hover:bg-white">Add domain</button>
					</form>
					<div class="grid gap-4">
						if len(saved) == 0 {
							<p class="border border-white/10 bg-card p-6 text-muted">No saved domains yet.</p>
						}
						for _, domain := range saved {
							@domainRow(domain)
						}
					</div>
				</section>
			</main>
		</body>
	</html>
}

templ domainRow(domain domains.Domain) {
	<article class="border border-white/10 bg-card p-5">
		<div class="flex flex-col justify-between gap-4 md:flex-row md:items-start">
			<div>
				<h2 class="text-2xl font-semibold text-white">{ domain.Domain }</h2>
				if domain.LatestCheck != nil {
					<p class="mt-2 font-mono text-xs uppercase tracking-[0.18em] text-muted">Checked { domain.LatestCheck.CheckedAt.Format("2006-01-02 15:04 UTC") }</p>
				} else {
					<p class="mt-2 text-sm text-muted">No check has been recorded yet.</p>
				}
			</div>
			<div class="flex gap-2">
				<form method="post" action={ "/app/domains/" + domain.ID + "/check" }>
					<button class="border border-accent/40 px-4 py-3 font-mono text-xs uppercase tracking-[0.18em] text-accent" type="submit">Recheck</button>
				</form>
				<form method="post" action={ "/app/domains/" + domain.ID + "/delete" }>
					<button class="border border-white/10 px-4 py-3 font-mono text-xs uppercase tracking-[0.18em] text-muted" type="submit">Delete</button>
				</form>
			</div>
		</div>
		if domain.LatestCheck != nil {
			<div class="mt-5 grid gap-3 md:grid-cols-4">
				@checkResultCard(domain.LatestCheck.SPF)
				@checkResultCard(domain.LatestCheck.DKIM)
				@checkResultCard(domain.LatestCheck.DMARC)
				@checkResultCard(domain.LatestCheck.BIMI)
			</div>
		}
	</article>
}

templ checkCard(name string, status string, detail string, statusClass string, borderClass string) {
	<div class={ "border bg-white/[0.02] p-4 " + borderClass }>
		<div class="flex items-center justify-between gap-3">
			<p class="font-mono text-sm font-semibold text-white">{ name }</p>
			<p class={ "font-mono text-xs uppercase tracking-[0.2em] " + statusClass }>{ status }</p>
		</div>
		<p class="mt-3 text-sm text-muted">{ detail }</p>
	</div>
}

templ featureCard(name string, detail string) {
	<article class="border border-white/10 bg-white/[0.02] p-5">
		<p class="font-mono text-sm font-semibold text-accent">{ name }</p>
		<p class="mt-4 text-sm leading-6 text-muted">{ detail }</p>
	</article>
}

templ roadmapCard(phase string, detail string) {
	<article class="border border-white/10 bg-card p-6">
		<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">{ phase }</p>
		<p class="mt-4 text-base leading-7 text-muted">{ detail }</p>
	</article>
}
