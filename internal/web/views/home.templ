package views

import (
	"fmt"

	"github.com/AndriGitDev/meil/internal/brand"
	"github.com/AndriGitDev/meil/internal/brandrisk"
	"github.com/AndriGitDev/meil/internal/domains"
	"github.com/AndriGitDev/meil/internal/salesaudit"
	"github.com/AndriGitDev/meil/internal/scanner"
	"github.com/AndriGitDev/meil/internal/trustreport"
)

type Flash struct {
	Kind    string
	Message string
}

func flashClass(kind string) string {
	switch kind {
	case "success":
		return "border-accent/30 bg-accent/10 text-accent"
	case "error":
		return "border-fail/30 bg-fail/10 text-fail"
	default:
		return "border-white/10 bg-white/[0.03] text-muted"
	}
}

func auditRiskClass(risk salesaudit.RiskLevel) string {
	switch risk {
	case salesaudit.RiskLow:
		return "border-accent/30 bg-accent/10 text-accent"
	case salesaudit.RiskMedium:
		return "border-yellow/35 bg-yellow/10 text-yellow"
	case salesaudit.RiskHigh:
		return "border-warn/35 bg-warn/10 text-warn"
	default:
		return "border-fail/35 bg-fail/10 text-fail"
	}
}

templ Home() {
	<!doctype html>
	<html lang="en" class="bg-[#090909] text-[#f2f2f2]">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ brand.FullProductName } - Brand-name risk defense</title>
			<meta name="description" content={ brand.ProductDescription }/>
			<meta property="og:title" content={ brand.FullProductName }/>
			<meta property="og:description" content={ brand.ProductDescription }/>
			<meta property="og:url" content={ brand.PrimaryURL }/>
			<meta property="og:type" content="website"/>
			<link rel="canonical" href={ brand.PrimaryURL }/>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
			<script defer src="/assets/js/alpine.min.js"></script>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<main class="mx-auto max-w-7xl px-5 py-6 sm:px-8 lg:px-10">
				<header class="flex items-center justify-between border-b border-white/10 pb-5">
					@brandLockup(brand.FullProductName, "Kastro RecordMaster home")
					<nav class="hidden items-center gap-8 text-sm text-muted md:flex" aria-label="Primary navigation">
						<a class="transition hover:text-foreground" href="#checker">Checker</a>
						<a class="transition hover:text-foreground" href="#monitor">Monitor</a>
						<a class="transition hover:text-foreground" href="#reporter">Reporter</a>
						<a class="transition hover:text-foreground" href="#defender">Defender</a>
						<a class="transition hover:text-foreground" href="#pricing">Pricing</a>
						<a class="transition hover:text-foreground" href="/security">Docs</a>
					</nav>
				</header>

				<section class="grid gap-12 py-14 lg:grid-cols-[1fr_0.95fr] lg:items-center lg:py-20" x-data="{ checked: false, domain: 'northstar.dev' }">
					<div class="max-w-3xl space-y-8">
						<div class="inline-flex items-center gap-3 border border-yellow/35 bg-yellow/10 px-3 py-2 font-mono text-xs uppercase tracking-[0.24em] text-yellow">
							<span class="text-base leading-none">✶</span>
							Brand-name risk defense
						</div>
						<div class="space-y-5">
							<p class="font-mono text-sm uppercase tracking-[0.22em] text-accent">{ brand.FullProductName }</p>
							<h1 class="max-w-4xl text-5xl font-semibold tracking-tight text-white sm:text-6xl lg:text-7xl">{ brand.HeroHeadline }</h1>
							<p class="max-w-2xl text-lg leading-8 text-muted sm:text-xl sm:leading-9">{ brand.HeroSubheading }</p>
						</div>
						<div id="checker" class="space-y-3">
							<form method="post" action="/check" class="grid max-w-2xl gap-3 border border-white/10 bg-card/90 p-2 shadow-2xl shadow-black/30 sm:grid-cols-[1fr_auto]">
								<label class="sr-only" for="domain">Domain</label>
								<input id="domain" name="domain" type="text" class="min-h-14 bg-transparent px-4 font-mono text-base text-white outline-none placeholder:text-muted/60" placeholder="yourdomain.com" autocomplete="off"/>
								<button type="submit" class="min-h-14 bg-accent px-6 font-mono text-sm font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-white hover:text-black">Check domain</button>
							</form>
							<a href="/login" class="inline-flex min-h-12 items-center border border-yellow/40 px-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-yellow transition hover:border-white hover:text-white">Protect my domains</a>
						</div>
						<div class="grid gap-3 text-sm text-muted sm:grid-cols-3">
							<p><span class="font-mono text-yellow">01</span> DNS posture snapshot</p>
							<p><span class="font-mono text-yellow">02</span> Drift and risk detection</p>
							<p><span class="font-mono text-yellow">03</span> Alert-ready history</p>
						</div>
					</div>

					<section id="preview" class="border border-white/10 bg-[#111]/95 p-4 shadow-2xl shadow-black/40 sm:p-6" aria-label="Trust report preview">
						<div class="mb-5 flex items-start justify-between gap-4 border-b border-white/10 pb-5">
							<div>
								<p class="font-mono text-xs uppercase tracking-[0.24em] text-muted">Trust report preview</p>
								<h2 class="mt-2 text-2xl font-semibold text-white" x-text="checked && domain ? domain : 'northstar.dev'">northstar.dev</h2>
							</div>
							<div class="border border-accent/30 bg-accent/10 px-3 py-2 text-right">
								<p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Domain trust score</p>
								<p class="text-2xl font-semibold text-white">92</p>
							</div>
						</div>
						<div class="grid gap-3 sm:grid-cols-2">
							@checkCard("DNS posture", "Healthy", "Authoritative records are visible.", "text-accent", "border-accent/30")
							@checkCard("Email authentication", "Watch", "DMARC policy is p=none.", "text-warn", "border-warn/30")
							@checkCard("Brand-name risk", "Low", "No high-risk signal in current records.", "text-accent", "border-accent/30")
							@checkCard("Sender evidence", "Collecting", "DMARC reports can add attribution.", "text-yellow", "border-yellow/30")
						</div>
						<div class="mt-5 space-y-3 border border-white/10 bg-black/30 p-4">
							<div class="flex items-center justify-between gap-4">
								<p class="font-mono text-xs uppercase tracking-[0.22em] text-muted">Trust timeline</p>
								<p class="font-mono text-xs text-yellow">Last 14 days</p>
							</div>
							<div class="grid grid-cols-[repeat(14,minmax(0,1fr))] gap-1" aria-hidden="true">
								<div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-warn/50"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div><div class="h-12 bg-accent/25"></div>
							</div>
							<p class="text-sm leading-6 text-muted">DMARC policy relaxed seven days ago. RecordMaster keeps the change visible so it does not disappear into DNS history.</p>
						</div>
					</section>
				</section>

				<section id="monitor" class="grid gap-4 border-y border-white/10 py-12 md:grid-cols-3 lg:grid-cols-6">
					@featureCard("DNS Records", "Know what your domain publishes.")
					@featureCard("Email Authentication", "Watch SPF, DKIM, DMARC, and BIMI.")
					@featureCard("Drift Detection", "Catch record changes before they become incidents.")
					@featureCard("Sender Evidence", "Use DMARC reports to identify who sends as your domain.")
					@featureCard("Brand-Name Risk", "Spot spoofing and impersonation signals.")
					@featureCard("Operator Alerts", "Get actionable before/after context.")
				</section>

				<section id="reporter" class="grid gap-8 py-16 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
					<div class="space-y-4">
						<p class="font-mono text-xs uppercase tracking-[0.24em] text-yellow">From DNS truth to brand-name defense</p>
						<h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">Start with public DNS truth. Grow into protected monitoring, sender evidence, and brand risk.</h2>
						<p class="max-w-2xl text-sm leading-6 text-muted">Start with public DNS truth. Add protected domains, scheduled drift monitoring, DMARC reporting, sender attribution, and brand-name risk defense as your needs grow.</p>
					</div>
					<div class="grid gap-4 sm:grid-cols-2">
						@roadmapCard("RecordMaster Checker", "Public domain, DNS, and email-auth posture checks.")
						@roadmapCard("RecordMaster Monitor", "Protected domains, scheduled scans, history, and drift alerts.")
						@roadmapCard("RecordMaster Reporter", "DMARC aggregate reports, sender inventory, and attribution.")
						@roadmapCard("RecordMaster Defender", "Brand-name risk findings from DNS, email-auth, and sender evidence.")
					</div>
				</section>
				<section id="defender" class="border-t border-white/10 py-12">
					<div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-center">
						<div class="space-y-4">
							<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">Kastro-managed option</p>
							<h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">Managed brand-name risk defense for teams that want expert review.</h2>
							<p class="text-sm leading-6 text-muted">Kastro can help set up protected domains, review alerts, coordinate DNS fixes, and turn monthly trust posture into an operator-ready summary.</p>
						</div>
						<a href="/login" class="inline-flex min-h-12 w-fit items-center bg-accent px-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-white hover:text-black">Start monitoring</a>
					</div>
				</section>
				<section id="pricing" class="border-t border-white/10 py-12">
					<div class="mb-8 max-w-2xl space-y-4">
						<p class="font-mono text-xs uppercase tracking-[0.24em] text-yellow">Pricing and packaging</p>
						<h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">Start with the free checker. Add monitoring, reporting, and Defender coverage as risk grows.</h2>
					</div>
					<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-5">
						@roadmapCard("Free Checker", "Public SPF, DKIM, DMARC, BIMI posture and basic recommendations.")
						@roadmapCard("Monitor", "Protected domains, scheduled scans, drift alerts, history, and weekly summaries.")
						@roadmapCard("Reporter", "DMARC aggregate ingestion, sender inventory, unknown sender alerts, and alignment analysis.")
						@roadmapCard("Defender", "Brand watch terms, evidence-backed risk findings, and future lookalike-domain monitoring.")
						@roadmapCard("Managed by Kastro", "Setup, monitoring review, monthly reports, DNS remediation support, and escalation help.")
					</div>
				</section>
			</main>
		</body>
	</html>
}

templ CheckResult(result scanner.Result, audit salesaudit.Result, csrfToken string) {
	<!doctype html>
	<html lang="en" class="bg-[#090909] text-[#f2f2f2]">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ result.Domain } - RecordMaster Checker</title>
			<meta name="description" content="Current public DNS, SPF, DKIM, DMARC, and BIMI posture."/>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<main class="mx-auto max-w-7xl px-5 py-6 sm:px-8 lg:px-10">
				<header class="flex items-center justify-between border-b border-white/10 pb-5">
					@brandLockup("RecordMaster", "Kastro RecordMaster home")
					<a class="font-mono text-xs uppercase tracking-[0.2em] text-yellow" href="/">New check</a>
				</header>

				<section class="space-y-8 py-12">
					<div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
						<div class="space-y-4">
							<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">Live trust audit</p>
							<h1 class="text-5xl font-semibold tracking-tight text-white">{ result.Domain }</h1>
							<p class="max-w-2xl text-lg leading-8 text-muted">{ audit.Message }</p>
							<form method="post" action="/claim-audit" class="grid max-w-2xl gap-3 border border-white/10 bg-card/90 p-2 sm:grid-cols-[1fr_auto]">
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<input type="hidden" name="domain" value={ result.Domain }/>
								<label class="sr-only" for="claim-email">Work email</label>
								<input id="claim-email" name="email" type="email" required class="min-h-14 bg-transparent px-4 font-mono text-base text-white outline-none placeholder:text-muted/60" placeholder={ "you@" + result.Domain } autocomplete="email"/>
								<button type="submit" class="min-h-14 bg-accent px-6 font-mono text-sm font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-white hover:text-black">Claim audit</button>
							</form>
							<p class="max-w-2xl font-mono text-xs uppercase tracking-[0.18em] text-yellow">{ audit.CTA }</p>
						</div>
						<aside class="border border-white/10 bg-card p-5" aria-label="Sales audit summary">
							<p class="font-mono text-xs uppercase tracking-[0.24em] text-muted">Audit grade</p>
							<div class="mt-4 flex items-end justify-between gap-4">
								<p class="text-6xl font-semibold tracking-tight text-white">{ audit.Grade }</p>
								<p class={ "border px-3 py-2 font-mono text-xs uppercase tracking-[0.18em] " + auditRiskClass(audit.Risk) }>{ string(audit.Risk) } risk</p>
							</div>
							if audit.Safe {
								<p class="mt-5 text-sm leading-6 text-muted">DMARC enforcement is active. Keep this domain watched for sender and DNS drift.</p>
							} else {
								<p class="mt-5 text-sm leading-6 text-muted">DMARC is not enforcing yet. RecordMaster can turn this public check into a tracked remediation plan.</p>
							}
						</aside>
					</div>

					<div class="grid gap-4 md:grid-cols-4">
						@checkResultCard(result.SPF)
						@checkResultCard(result.DKIM)
						@checkResultCard(result.DMARC)
						@checkResultCard(result.BIMI)
					</div>
				</section>
			</main>
		</body>
	</html>
}

templ checkResultCard(check scanner.CheckResult) {
	<article class="border border-white/10 bg-card p-5">
		<div class="flex items-center justify-between gap-3">
			<p class="font-mono text-sm font-semibold text-white">{ check.Name }</p>
			<p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">{ string(check.Status) }</p>
		</div>
		<p class="mt-4 text-sm leading-6 text-muted">{ check.Message }</p>
		if check.Record != "" {
			<pre class="mt-4 overflow-x-auto whitespace-pre-wrap break-words border border-white/10 bg-black/30 p-4 text-xs leading-6 text-muted">{ check.Record }</pre>
		}
	</article>
}

templ Login(csrfToken string) {
	<!doctype html>
	<html lang="en" class="bg-[#090909] text-[#f2f2f2]">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Sign in - { brand.FullProductName }</title>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<main class="mx-auto grid min-h-screen max-w-xl place-items-center px-5 py-12">
				<section class="w-full border border-white/10 bg-card p-8">
					<a href="/" class="font-mono text-xs uppercase tracking-[0.2em] text-yellow">RecordMaster</a>
					<h1 class="mt-6 text-4xl font-semibold tracking-tight text-white">Sign in with email</h1>
					<p class="mt-4 text-sm leading-6 text-muted">Enter your email and RecordMaster will send a one-time magic link.</p>
					<form method="post" action="/login" class="mt-8 grid gap-3">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<label class="sr-only" for="email">Email</label>
						<input id="email" name="email" type="email" required class="min-h-14 border border-white/10 bg-black/30 px-4 font-mono text-base text-white outline-none placeholder:text-muted/60" placeholder="you@example.com" autocomplete="email"/>
						<button type="submit" class="min-h-14 bg-accent px-6 font-mono text-sm font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-white hover:text-black">Send magic link</button>
					</form>
				</section>
			</main>
		</body>
	</html>
}

templ LoginSent(email string) {
	<!doctype html>
	<html lang="en" class="bg-[#090909] text-[#f2f2f2]">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Check your email - { brand.FullProductName }</title>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<main class="mx-auto grid min-h-screen max-w-xl place-items-center px-5 py-12">
				<section class="w-full border border-white/10 bg-card p-8">
					<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">Magic link sent</p>
					<h1 class="mt-6 text-4xl font-semibold tracking-tight text-white">Check your email</h1>
					<p class="mt-4 text-sm leading-6 text-muted">A one-time sign-in link was sent to { email }. It expires shortly and can only be used once.</p>
					<a href="/login" class="mt-8 inline-flex min-h-12 items-center bg-accent px-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-white hover:text-black">Request another link</a>
				</section>
			</main>
		</body>
	</html>
}

templ LoginProblem(title string, detail string) {
	<!doctype html>
	<html lang="en" class="bg-[#090909] text-[#f2f2f2]">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } - { brand.FullProductName }</title>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<main class="mx-auto grid min-h-screen max-w-xl place-items-center px-5 py-12">
				<section class="w-full border border-white/10 bg-card p-8">
					<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">Sign in</p>
					<h1 class="mt-6 text-4xl font-semibold tracking-tight text-white">{ title }</h1>
					<p class="mt-4 text-sm leading-6 text-muted">{ detail }</p>
					<a href="/login" class="mt-8 inline-flex min-h-12 items-center bg-accent px-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-white hover:text-black">Request new link</a>
				</section>
			</main>
		</body>
	</html>
}

templ AppDomains(email string, saved []domains.Domain, csrfToken string, flashes []Flash) {
	<!doctype html>
	<html lang="en" class="bg-[#090909] text-[#f2f2f2]">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Protected Domains - { brand.FullProductName }</title>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<main class="mx-auto max-w-6xl px-5 py-6 sm:px-8 lg:px-10">
				@appHeader(email)
				<section class="space-y-8 py-12">
					<div class="space-y-3">
						<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">Signed in as { email }</p>
						<h1 class="text-5xl font-semibold tracking-tight text-white">Protected Domains</h1>
						<p class="max-w-2xl text-lg leading-8 text-muted">Protect domains and revisit their latest SPF, DKIM, DMARC, BIMI, trust timeline, and brand-risk posture.</p>
					</div>
					if len(flashes) > 0 {
						<div class="grid gap-2" role="status" aria-live="polite">
							for _, flash := range flashes {
								<p class={ "border px-4 py-3 text-sm " + flashClass(flash.Kind) }>{ flash.Message }</p>
							}
						</div>
					}
					<form method="post" action="/app/domains" class="grid max-w-2xl gap-3 border border-white/10 bg-card/80 p-2 sm:grid-cols-[1fr_auto]">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<label class="sr-only" for="domain">Domain</label>
						<input id="domain" name="domain" type="text" class="min-h-14 bg-transparent px-4 font-mono text-base text-white outline-none placeholder:text-muted/60" placeholder="yourdomain.com" autocomplete="off"/>
						<button type="submit" class="min-h-14 bg-accent px-6 font-mono text-sm font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-white hover:text-black">Protect domain</button>
					</form>
					<div class="grid gap-4">
						if len(saved) == 0 {
							<div class="border border-white/10 bg-card p-6">
								<h2 class="text-2xl font-semibold text-white">Protect your first domain</h2>
								<p class="mt-3 text-sm leading-6 text-muted">RecordMaster will monitor DNS records, email-auth posture, and trust drift for this domain. Reporter and Brand Risk modules can help identify unknown senders and spoofing indicators as coverage grows.</p>
							</div>
						}
						for _, domain := range saved {
							@domainRow(domain, csrfToken)
						}
					</div>
				</section>
			</main>
		</body>
	</html>
}

templ BrandRisk(email string, domain domains.Domain, findings []brandrisk.Finding, csrfToken string) {
	<!doctype html>
	<html lang="en" class="bg-[#090909] text-[#f2f2f2]">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Brand Risk - { domain.Domain } - { brand.FullProductName }</title>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<main class="mx-auto max-w-6xl px-5 py-6 sm:px-8 lg:px-10">
				@appHeader(email)
				<section class="space-y-8 py-12">
					<div class="space-y-3">
						<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">RecordMaster Defender</p>
						<h1 class="text-5xl font-semibold tracking-tight text-white">Brand Risk: { domain.Domain }</h1>
						<p class="max-w-3xl text-lg leading-8 text-muted">Findings use DNS and email-auth evidence already available for this protected domain. Lookalike-domain intelligence is not claimed here until the Defender feed is implemented.</p>
					</div>
					if domain.LatestCheck == nil {
						<div class="border border-white/10 bg-card p-6">
							<h2 class="text-2xl font-semibold text-white">No record check yet</h2>
							<p class="mt-3 text-sm leading-6 text-muted">Run a record check before reviewing brand-risk findings.</p>
							<form method="post" action={ "/app/domains/" + domain.ID + "/check" } class="mt-5">
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<button class="min-h-12 bg-accent px-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-white hover:text-black" type="submit">Check domain</button>
							</form>
						</div>
					} else {
						<div class="grid gap-4">
							for _, finding := range findings {
								@brandRiskFinding(finding)
							}
						</div>
					}
				</section>
			</main>
		</body>
	</html>
}

templ TrustReport(email string, domain domains.Domain, report trustreport.Report, csrfToken string) {
	<!doctype html>
	<html lang="en" class="bg-[#090909] text-[#f2f2f2]">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Trust Report - { domain.Domain } - { brand.FullProductName }</title>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<main class="mx-auto max-w-6xl px-5 py-6 sm:px-8 lg:px-10">
				@appHeader(email)
				<section class="space-y-8 py-12">
					<div class="space-y-3">
						<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">RecordMaster trust report</p>
						<h1 class="text-5xl font-semibold tracking-tight text-white">Trust Report: { domain.Domain }</h1>
						<p class="max-w-3xl text-lg leading-8 text-muted">{ report.ExecutiveSummary }</p>
					</div>
					if domain.LatestCheck == nil {
						<div class="border border-white/10 bg-card p-6">
							<h2 class="text-2xl font-semibold text-white">No record check yet</h2>
							<p class="mt-3 text-sm leading-6 text-muted">Run a record check before generating a trust report for this protected domain.</p>
							<form method="post" action={ "/app/domains/" + domain.ID + "/check" } class="mt-5">
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<button class="min-h-12 bg-accent px-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-white hover:text-black" type="submit">Check domain</button>
							</form>
						</div>
					} else if len(report.Domains) > 0 {
						@trustReportSection(report.Domains[0])
					}
				</section>
			</main>
		</body>
	</html>
}

templ trustReportSection(section trustreport.DomainSection) {
	<div class="grid gap-4 md:grid-cols-3">
		@metricCard("Posture score", fmt.Sprintf("%d", section.PostureScore), string(section.PostureStatus))
		@metricCard("Unknown senders", fmt.Sprintf("%d", section.UnknownSenderCount), "from reporter evidence")
		@metricCard("Top issue", section.TopIssue, "current blocker")
	</div>
	<section class="grid gap-4 lg:grid-cols-[0.9fr_1.1fr]">
		<article class="border border-white/10 bg-card p-5">
			<p class="font-mono text-xs uppercase tracking-[0.24em] text-muted">DMARC journey</p>
			<h2 class="mt-3 text-3xl font-semibold text-white">{ string(section.DMARCJourney.State) }</h2>
			<p class="mt-3 text-sm leading-6 text-muted">Policy { section.DMARCJourney.Policy } at { fmt.Sprintf("%d", section.DMARCJourney.Percent) }%.</p>
			<p class="mt-4 text-sm leading-6 text-muted">{ section.DMARCJourney.Reason }</p>
			<p class="mt-4 border border-white/10 bg-black/30 p-4 text-sm leading-6 text-foreground">{ section.DMARCJourney.NextAction }</p>
			if len(section.DMARCJourney.BlockingSignals) > 0 {
				<div class="mt-4 grid gap-2">
					for _, blocker := range section.DMARCJourney.BlockingSignals {
						<p class="border border-warn/30 bg-warn/10 px-3 py-2 text-sm text-warn">{ blocker }</p>
					}
				</div>
			}
		</article>
		<div class="grid gap-4">
			if len(section.Recommendations) > 0 {
				for _, recommendation := range section.Recommendations {
					<article class="border border-white/10 bg-card p-5">
						<p class="font-mono text-xs uppercase tracking-[0.2em] text-yellow">Priority { fmt.Sprintf("%d", recommendation.Priority) }</p>
						<h2 class="mt-2 text-2xl font-semibold text-white">{ recommendation.Title }</h2>
						<p class="mt-3 text-sm leading-6 text-muted">{ recommendation.Action }</p>
					</article>
				}
			} else {
				<article class="border border-white/10 bg-card p-5">
					<h2 class="text-2xl font-semibold text-white">No urgent recommendations</h2>
					<p class="mt-3 text-sm leading-6 text-muted">The current scan did not produce a remediation recommendation. Keep monitoring for drift.</p>
				</article>
			}
		</div>
	</section>
	<section class="grid gap-4">
		for _, finding := range section.Findings {
			@brandRiskFinding(finding)
		}
	</section>
}

templ metricCard(label string, value string, detail string) {
	<article class="border border-white/10 bg-card p-5">
		<p class="font-mono text-xs uppercase tracking-[0.22em] text-muted">{ label }</p>
		<p class="mt-3 text-3xl font-semibold text-white">{ value }</p>
		<p class="mt-2 text-sm text-muted">{ detail }</p>
	</article>
}

templ domainRow(domain domains.Domain, csrfToken string) {
	<article class="border border-white/10 bg-card p-5">
		<div class="flex flex-col justify-between gap-4 md:flex-row md:items-start">
			<div>
				<h2 class="text-2xl font-semibold text-white">{ domain.Domain }</h2>
				if domain.LatestCheck != nil {
					<p class="mt-2 font-mono text-xs uppercase tracking-[0.18em] text-muted">Checked { domain.LatestCheck.CheckedAt.Format("2006-01-02 15:04 UTC") }</p>
				} else {
					<p class="mt-2 text-sm text-muted">No record check has been recorded yet.</p>
				}
			</div>
			<div class="flex flex-wrap gap-2">
				<a href={ "/app/domains/" + domain.ID + "/trust-report" } class="border border-accent/40 px-4 py-3 font-mono text-xs uppercase tracking-[0.18em] text-accent">Trust report</a>
				<a href={ "/app/domains/" + domain.ID + "/brand-risk" } class="border border-yellow/40 px-4 py-3 font-mono text-xs uppercase tracking-[0.18em] text-yellow">Review brand risk</a>
				<form method="post" action={ "/app/domains/" + domain.ID + "/check" }>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button class="border border-accent/40 px-4 py-3 font-mono text-xs uppercase tracking-[0.18em] text-accent" type="submit">Recheck</button>
				</form>
				<form method="post" action={ "/app/domains/" + domain.ID + "/delete" }>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button class="border border-white/10 px-4 py-3 font-mono text-xs uppercase tracking-[0.18em] text-muted" type="submit">Delete</button>
				</form>
			</div>
		</div>
		if domain.LatestCheck != nil {
			<div class="mt-5 grid gap-3 md:grid-cols-4">
				@checkResultCard(domain.LatestCheck.SPF)
				@checkResultCard(domain.LatestCheck.DKIM)
				@checkResultCard(domain.LatestCheck.DMARC)
				@checkResultCard(domain.LatestCheck.BIMI)
			</div>
		}
	</article>
}

templ brandRiskFinding(finding brandrisk.Finding) {
	<article class="border border-white/10 bg-card p-5">
		<div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-start">
			<div>
				<p class="font-mono text-xs uppercase tracking-[0.22em] text-muted">{ finding.Category }</p>
				<h2 class="mt-2 text-2xl font-semibold text-white">{ finding.Title }</h2>
			</div>
			<p class="w-fit border border-yellow/30 bg-yellow/10 px-3 py-2 font-mono text-xs uppercase tracking-[0.18em] text-yellow">{ string(finding.Severity) }</p>
		</div>
		<p class="mt-4 text-sm leading-6 text-muted">{ finding.Evidence }</p>
		<p class="mt-4 border border-white/10 bg-black/30 p-4 text-sm leading-6 text-foreground">{ finding.RecommendedAction }</p>
	</article>
}

templ appHeader(email string) {
	<header class="flex flex-col gap-5 border-b border-white/10 pb-5 lg:flex-row lg:items-center lg:justify-between">
		@brandLockup("RecordMaster", "Kastro RecordMaster home")
		<nav class="flex flex-wrap gap-4 text-sm text-muted" aria-label="App navigation">
			<a class="text-white" href="/app/domains">Protected Domains</a>
			<a class="transition hover:text-white" href="/app/domains">Records</a>
			<a class="transition hover:text-white" href="/app/domains">Alerts</a>
			<a class="transition hover:text-white" href="/app/domains">Reporter</a>
			<a class="transition hover:text-white" href="/app/defender">Brand Risk</a>
			<a class="font-mono text-xs uppercase tracking-[0.2em] text-yellow" href="/logout">Sign out</a>
		</nav>
	</header>
}

templ brandLockup(label string, ariaLabel string) {
	<a href="/" class="flex items-center gap-3" aria-label={ ariaLabel }>
		<span class="grid h-9 w-9 place-items-center border border-yellow/40 bg-yellow/10 font-mono text-base font-semibold text-yellow">✶</span>
		<span class="text-lg font-semibold tracking-tight">{ label }</span>
	</a>
}

templ checkCard(name string, status string, detail string, statusClass string, borderClass string) {
	<div class={ "border bg-white/[0.02] p-4 " + borderClass }>
		<div class="flex items-center justify-between gap-3">
			<p class="font-mono text-sm font-semibold text-white">{ name }</p>
			<p class={ "font-mono text-xs uppercase tracking-[0.2em] " + statusClass }>{ status }</p>
		</div>
		<p class="mt-3 text-sm text-muted">{ detail }</p>
	</div>
}

templ featureCard(name string, detail string) {
	<article class="border border-white/10 bg-white/[0.02] p-5">
		<p class="font-mono text-sm font-semibold text-yellow">{ name }</p>
		<p class="mt-4 text-sm leading-6 text-muted">{ detail }</p>
	</article>
}

templ roadmapCard(phase string, detail string) {
	<article class="border border-white/10 bg-card p-6">
		<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">{ phase }</p>
		<p class="mt-4 text-base leading-7 text-muted">{ detail }</p>
	</article>
}
