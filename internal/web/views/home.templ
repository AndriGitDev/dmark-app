				<section class="w-full border border-border bg-card p-8">
					<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">Sign in</p>
					<h1 class="mt-6 text-4xl font-semibold tracking-tight text-ink">{ title }</h1>
					<p class="mt-4 text-sm leading-6 text-muted">{ detail }</p>
					<a href="/login" class="mt-8 inline-flex min-h-12 items-center bg-accent px-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-accent-hover">Request new link</a>
				</section>
			</main>
		</body>
	</html>
}

templ AppDomains(email string, saved []domains.Domain, csrfToken string, flashes []Flash) {
	<!doctype html>
	<html lang="en" class="bg-white text-ink">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Protected Domains - { brand.FullProductName }</title>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<main class="mx-auto max-w-6xl px-5 py-6 sm:px-8 lg:px-10">
				@appHeader(email)
				<section class="space-y-8 py-12">
					<div class="space-y-3">
						<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">Signed in as { email }</p>
						<h1 class="text-5xl font-semibold tracking-tight text-ink">Protected Domains</h1>
						<p class="max-w-2xl text-lg leading-8 text-muted">Protect domains and revisit their latest SPF, DKIM, DMARC, BIMI, trust timeline, and brand-risk posture.</p>
					</div>
					if len(flashes) > 0 {
						<div class="grid gap-2" role="status" aria-live="polite">
							for _, flash := range flashes {
								<p class={ "border px-4 py-3 text-sm " + flashClass(flash.Kind) }>{ flash.Message }</p>
							}
						</div>
					}
					<form method="post" action="/app/domains" class="grid max-w-2xl gap-3 border border-border bg-card/80 p-2 sm:grid-cols-[1fr_auto]">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<label class="sr-only" for="domain">Domain</label>
						<input id="domain" name="domain" type="text" class="min-h-14 bg-transparent px-4 font-mono text-base text-ink outline-none placeholder:text-muted/60" placeholder="yourdomain.com" autocomplete="off"/>
						<button type="submit" class="min-h-14 bg-accent px-6 font-mono text-sm font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-accent-hover">Protect domain</button>
					</form>
					<div class="grid gap-4">
						if len(saved) == 0 {
							<div class="border border-border bg-card p-6">
								<h2 class="text-2xl font-semibold text-ink">Protect your first domain</h2>
								<p class="mt-3 text-sm leading-6 text-muted">Dmark will monitor DNS records, email-auth posture, and trust drift for this domain. Reporter and Brand Risk modules can help identify unknown senders and spoofing indicators as coverage grows.</p>
							</div>
						}
						for _, domain := range saved {
							@domainRow(domain, csrfToken)
						}
					</div>
				</section>
			</main>
		</body>
	</html>
}

templ BrandRisk(email string, domain domains.Domain, findings []brandrisk.Finding, csrfToken string) {
	<!doctype html>
	<html lang="en" class="bg-white text-ink">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Brand Risk - { domain.Domain } - { brand.FullProductName }</title>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<main class="mx-auto max-w-6xl px-5 py-6 sm:px-8 lg:px-10">
				@appHeader(email)
				<section class="space-y-8 py-12">
					<div class="space-y-3">
						<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">Dmark Defender</p>
						<h1 class="text-5xl font-semibold tracking-tight text-ink">Brand Risk: { domain.Domain }</h1>
						<p class="max-w-3xl text-lg leading-8 text-muted">Findings use DNS and email-auth evidence already available for this protected domain. Lookalike-domain intelligence is not claimed here until the Defender feed is implemented.</p>
					</div>
					if domain.LatestCheck == nil {
						<div class="border border-border bg-card p-6">
							<h2 class="text-2xl font-semibold text-ink">No record check yet</h2>
							<p class="mt-3 text-sm leading-6 text-muted">Run a record check before reviewing brand-risk findings.</p>
							<form method="post" action={ "/app/domains/" + domain.ID + "/check" } class="mt-5">
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<button class="min-h-12 bg-accent px-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-accent-hover" type="submit">Check domain</button>
							</form>
						</div>
					} else {
						<div class="grid gap-4">
							for _, finding := range findings {
								@brandRiskFinding(finding)
							}
						</div>
					}
				</section>
			</main>
		</body>
	</html>
}

templ TrustReport(email string, domain domains.Domain, report trustreport.Report, csrfToken string) {
	<!doctype html>
	<html lang="en" class="bg-white text-ink">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Trust Report - { domain.Domain } - { brand.FullProductName }</title>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<main class="mx-auto max-w-6xl px-5 py-6 sm:px-8 lg:px-10">
				@appHeader(email)
				<section class="space-y-8 py-12">
					<div class="space-y-3">
						<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">Dmark trust report</p>
						<h1 class="text-5xl font-semibold tracking-tight text-ink">Trust Report: { domain.Domain }</h1>
						<p class="max-w-3xl text-lg leading-8 text-muted">{ report.ExecutiveSummary }</p>
					</div>
					if domain.LatestCheck == nil {
						<div class="border border-border bg-card p-6">
							<h2 class="text-2xl font-semibold text-ink">No record check yet</h2>
							<p class="mt-3 text-sm leading-6 text-muted">Run a record check before generating a trust report for this protected domain.</p>
							<form method="post" action={ "/app/domains/" + domain.ID + "/check" } class="mt-5">
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<button class="min-h-12 bg-accent px-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-accent-hover" type="submit">Check domain</button>
							</form>
						</div>
					} else if len(report.Domains) > 0 {
						@trustReportSection(report.Domains[0])
					}
				</section>
			</main>
		</body>
	</html>
}

templ trustReportSection(section trustreport.DomainSection) {
	<div class="grid gap-4 md:grid-cols-3">
		@metricCard("Posture score", fmt.Sprintf("%d", section.PostureScore), string(section.PostureStatus))
		@metricCard("Unknown senders", fmt.Sprintf("%d", section.UnknownSenderCount), "from reporter evidence")
		@metricCard("Top issue", section.TopIssue, "current blocker")
	</div>
	<section class="grid gap-4 lg:grid-cols-[0.9fr_1.1fr]">
		<article class="border border-border bg-card p-5">
			<p class="font-mono text-xs uppercase tracking-[0.24em] text-muted">DMARC journey</p>
			<h2 class="mt-3 text-3xl font-semibold text-ink">{ string(section.DMARCJourney.State) }</h2>
			<p class="mt-3 text-sm leading-6 text-muted">Policy { section.DMARCJourney.Policy } at { fmt.Sprintf("%d", section.DMARCJourney.Percent) }%.</p>
			<p class="mt-4 text-sm leading-6 text-muted">{ section.DMARCJourney.Reason }</p>
			<p class="mt-4 border border-border bg-subtle p-4 text-sm leading-6 text-foreground">{ section.DMARCJourney.NextAction }</p>
			if len(section.DMARCJourney.BlockingSignals) > 0 {
				<div class="mt-4 grid gap-2">
					for _, blocker := range section.DMARCJourney.BlockingSignals {
						<p class="border border-warn/30 bg-warn/10 px-3 py-2 text-sm text-warn">{ blocker }</p>
					}
				</div>
			}
		</article>
		<div class="grid gap-4">
			if len(section.Recommendations) > 0 {
				for _, recommendation := range section.Recommendations {
					<article class="border border-border bg-card p-5">
						<p class="font-mono text-xs uppercase tracking-[0.2em] text-yellow">Priority { fmt.Sprintf("%d", recommendation.Priority) }</p>
						<h2 class="mt-2 text-2xl font-semibold text-ink">{ recommendation.Title }</h2>
						<p class="mt-3 text-sm leading-6 text-muted">{ recommendation.Action }</p>
					</article>
				}
			} else {
				<article class="border border-border bg-card p-5">
					<h2 class="text-2xl font-semibold text-ink">No urgent recommendations</h2>
					<p class="mt-3 text-sm leading-6 text-muted">The current scan did not produce a remediation recommendation. Keep monitoring for drift.</p>
				</article>
			}
		</div>
	</section>
	<section class="grid gap-4">
		for _, finding := range section.Findings {
			@brandRiskFinding(finding)
		}
	</section>
}

templ metricCard(label string, value string, detail string) {
	<article class="border border-border bg-card p-5">
		<p class="font-mono text-xs uppercase tracking-[0.22em] text-muted">{ label }</p>
		<p class="mt-3 text-3xl font-semibold text-ink">{ value }</p>
		<p class="mt-2 text-sm text-muted">{ detail }</p>
	</article>
}

templ domainRow(domain domains.Domain, csrfToken string) {
	<article class="border border-border bg-card p-5">
		<div class="flex flex-col justify-between gap-4 md:flex-row md:items-start">
			<div>
				<h2 class="text-2xl font-semibold text-ink">{ domain.Domain }</h2>
				if domain.LatestCheck != nil {
					<p class="mt-2 font-mono text-xs uppercase tracking-[0.18em] text-muted">Checked { domain.LatestCheck.CheckedAt.Format("2006-01-02 15:04 UTC") }</p>
				} else {
					<p class="mt-2 text-sm text-muted">No record check has been recorded yet.</p>
				}
			</div>
			<div class="flex flex-wrap gap-2">
				<a href={ "/app/domains/" + domain.ID + "/trust-report" } class="border border-accent/40 px-4 py-3 font-mono text-xs uppercase tracking-[0.18em] text-accent">Trust report</a>
				<a href={ "/app/domains/" + domain.ID + "/brand-risk" } class="border border-yellow/40 px-4 py-3 font-mono text-xs uppercase tracking-[0.18em] text-yellow">Review brand risk</a>
				<form method="post" action={ "/app/domains/" + domain.ID + "/check" }>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button class="border border-accent/40 px-4 py-3 font-mono text-xs uppercase tracking-[0.18em] text-accent" type="submit">Recheck</button>
				</form>
				<form method="post" action={ "/app/domains/" + domain.ID + "/delete" }>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button class="border border-border px-4 py-3 font-mono text-xs uppercase tracking-[0.18em] text-muted" type="submit">Delete</button>
				</form>
			</div>
		</div>
		if domain.LatestCheck != nil {
			<div class="mt-5 grid gap-3 md:grid-cols-4">
				@checkResultCard(domain.LatestCheck.SPF)
				@checkResultCard(domain.LatestCheck.DKIM)
				@checkResultCard(domain.LatestCheck.DMARC)
				@checkResultCard(domain.LatestCheck.BIMI)
			</div>
		}
	</article>
}

templ brandRiskFinding(finding brandrisk.Finding) {
	<article class="border border-border bg-card p-5">
		<div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-start">
			<div>
				<p class="font-mono text-xs uppercase tracking-[0.22em] text-muted">{ finding.Category }</p>
				<h2 class="mt-2 text-2xl font-semibold text-ink">{ finding.Title }</h2>
			</div>
			<p class="w-fit border border-yellow/30 bg-yellow/10 px-3 py-2 font-mono text-xs uppercase tracking-[0.18em] text-yellow">{ string(finding.Severity) }</p>
		</div>
		<p class="mt-4 text-sm leading-6 text-muted">{ finding.Evidence }</p>
		<p class="mt-4 border border-border bg-subtle p-4 text-sm leading-6 text-foreground">{ finding.RecommendedAction }</p>
	</article>
}

templ appHeader(email string) {
	<header class="flex flex-col gap-5 border-b border-border pb-5 lg:flex-row lg:items-center lg:justify-between">
		@brandLockup("dmark", "Dmark home")
		<nav class="flex flex-wrap gap-4 text-sm text-muted" aria-label="App navigation">
			<a class="text-ink" href="/app/domains">Protected Domains</a>
			<a class="transition hover:text-ink" href="/app/domains">Records</a>
			<a class="transition hover:text-ink" href="/app/domains">Alerts</a>
			<a class="transition hover:text-ink" href="/app/domains">Reporter</a>
			<a class="transition hover:text-ink" href="/app/defender">Brand Risk</a>
			<a class="font-mono text-xs uppercase tracking-[0.2em] text-accent" href="/logout">Sign out</a>
		</nav>
	</header>
}

templ brandLockup(label string, ariaLabel string) {
	<a href="/" class="inline-flex items-center" aria-label={ ariaLabel } data-label={ label }>
		<span class="text-xl font-bold tracking-tight text-ink">
			dmar<span class="bg-[linear-gradient(35deg,#0F172A_0_58%,#10B981_58%_100%)] bg-clip-text text-transparent">k</span>
		</span>
	</a>
}

templ checkCard(name string, status string, detail string, statusClass string, borderClass string) {
	<div class={ "border bg-white/[0.02] p-4 " + borderClass }>
		<div class="flex items-center justify-between gap-3">
			<p class="font-mono text-sm font-semibold text-ink">{ name }</p>
			<p class={ "font-mono text-xs uppercase tracking-[0.2em] " + statusClass }>{ status }</p>
		</div>
		<p class="mt-3 text-sm text-muted">{ detail }</p>
	</div>
}

templ featureCard(name string, detail string) {
	<article class="rounded-xl border border-border bg-white p-6 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
		<div class="grid h-10 w-10 place-items-center rounded-lg border border-accent/20 bg-accent/10 text-accent" aria-hidden="true">
			if name == "Analyze" {
				<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="11" cy="11" r="7"></circle>
					<path d="m21 21-4.3-4.3"></path>
				</svg>
			} else if name == "Demonstrate" {
				<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3v8Z"></path>
					<path d="m9 12 2 2 4-4"></path>
				</svg>
			} else {
				<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M3 12h6l2 3 4-8 2 5h4"></path>
					<path d="M3 20h18"></path>
				</svg>
			}
		</div>
		<p class="mt-5 text-base font-semibold text-ink">{ name }</p>
		<p class="mt-3 text-sm leading-6 text-muted">{ detail }</p>
	</article>
}

templ roadmapCard(phase string, detail string) {
	<article class="rounded-xl border border-border bg-card p-6">
		<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">{ phase }</p>
		<p class="mt-4 text-base leading-7 text-muted">{ detail }</p>
	</article>
}
