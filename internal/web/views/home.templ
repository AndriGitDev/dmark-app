package views

import (
	"fmt"

	"github.com/AndriGitDev/meil/internal/brand"
	"github.com/AndriGitDev/meil/internal/brandrisk"
	"github.com/AndriGitDev/meil/internal/domains"
	"github.com/AndriGitDev/meil/internal/salesaudit"
	"github.com/AndriGitDev/meil/internal/scanner"
	"github.com/AndriGitDev/meil/internal/trustreport"
)

type Flash struct {
	Kind    string
	Message string
}

func flashClass(kind string) string {
	switch kind {
	case "success":
		return "border-accent/30 bg-accent/10 text-accent"
	case "error":
		return "border-fail/30 bg-fail/10 text-fail"
	default:
		return "border-border bg-white/[0.03] text-muted"
	}
}

func auditRiskClass(risk salesaudit.RiskLevel) string {
	switch risk {
	case salesaudit.RiskLow:
		return "border-accent/30 bg-accent/10 text-accent"
	case salesaudit.RiskMedium:
		return "border-yellow/35 bg-yellow/10 text-yellow"
	case salesaudit.RiskHigh:
		return "border-warn/35 bg-warn/10 text-warn"
	default:
		return "border-fail/35 bg-fail/10 text-fail"
	}
}

templ Home() {
	<!doctype html>
	<html lang="en" class="bg-white text-ink">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ brand.FullProductName } - DMARC diagnostics and remediation</title>
			<meta name="description" content={ brand.ProductDescription }/>
			<meta property="og:title" content={ brand.FullProductName }/>
			<meta property="og:description" content={ brand.ProductDescription }/>
			<meta property="og:url" content={ brand.PrimaryURL }/>
			<meta property="og:type" content="website"/>
			<link rel="canonical" href={ brand.PrimaryURL }/>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
			<script defer src="/assets/js/alpine.min.js"></script>
			<style>
				[x-cloak] { display: none !important; }
				@keyframes dmark-scan {
					0% { transform: translateX(-100%); }
					100% { transform: translateX(220%); }
				}
				@keyframes dmark-pulse {
					0%, 100% { opacity: 0.48; }
					50% { opacity: 1; }
				}
				.scan-line { animation: dmark-scan 1.15s ease-in-out infinite; }
				.security-pulse { animation: dmark-pulse 1.8s ease-in-out infinite; }
			</style>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<header class="border-b border-border/70 bg-white/90 backdrop-blur">
				<div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-5 sm:px-8 lg:px-10">
					@brandLockup("dmark", "Dmark home")
					<a href={ brand.BookingURL } class="inline-flex min-h-10 items-center rounded-lg border border-border px-4 text-sm font-semibold text-ink shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition hover:border-accent hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent/30">Book Demo</a>
				</div>
			</header>

			<main>
				<section id="checker" class="mx-auto grid max-w-7xl gap-12 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:px-10 lg:py-24" x-data="{ state: 'input', email: '', domain: 'yourdomain.com', analyze() { const value = this.email.trim(); const parts = value.split('@'); this.domain = parts.length > 1 && parts[1] ? parts[1].toLowerCase() : 'yourdomain.com'; this.state = 'loading'; window.setTimeout(() => { this.state = 'rating' }, 1200); } }">
					<div class="max-w-3xl">
						<p class="text-sm font-semibold text-accent">Interactive DMARC diagnostic</p>
						<h1 class="mt-5 max-w-4xl text-5xl font-semibold leading-[1.02] tracking-tight text-ink sm:text-6xl lg:text-7xl">{ brand.HeroHeadline }</h1>
						<p class="mt-6 max-w-2xl text-lg leading-8 text-muted sm:text-xl sm:leading-9">{ brand.HeroSubheading }</p>
						<div class="mt-8 inline-flex items-start gap-3 rounded-xl border border-border bg-subtle px-4 py-3 text-sm leading-6 text-muted">
							<span class="mt-1 h-2.5 w-2.5 rounded-full bg-accent security-pulse" aria-hidden="true"></span>
							<span>Safe, double-opt-in testing. No unauthorized emails sent.</span>
						</div>
					</div>

					<section class="rounded-xl border border-border bg-white p-5 shadow-[0_4px_6px_-1px_rgba(0,0,0,0.05),0_2px_4px_-1px_rgba(0,0,0,0.03)] sm:p-6" aria-label="Interactive spoof diagnostic demo">
						<div class="flex items-center justify-between gap-4 border-b border-border pb-5">
							<div>
								<p class="text-sm font-semibold text-ink">Domain exposure check</p>
								<p class="mt-1 text-sm text-muted">DMARC, SPF, DKIM, and policy alignment</p>
							</div>
							<span class="rounded-full border border-accent/25 bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">Live demo</span>
						</div>

						<div class="mt-6" x-show="state === 'input'" x-transition.opacity.duration.250ms>
							<label class="text-sm font-medium text-ink" for="work-email">Enter your work email</label>
							<div class="mt-2 grid gap-3 sm:grid-cols-[1fr_auto]">
								<input id="work-email" name="email" type="email" x-model="email" class="min-h-12 rounded-lg border border-border bg-white px-4 text-base text-ink outline-none transition placeholder:text-muted/60 focus:border-accent focus:ring-4 focus:ring-accent/10" placeholder="you@company.com" autocomplete="email" aria-label="Enter your work email"/>
								<button type="button" x-on:click="analyze()" class="min-h-12 rounded-lg bg-accent px-5 text-sm font-semibold text-white shadow-[0_1px_2px_rgba(15,23,42,0.08)] transition hover:bg-accent-hover focus:outline-none focus:ring-4 focus:ring-accent/20">Analyze Domain</button>
							</div>
						</div>

						<div class="mt-6 space-y-4" x-show="state === 'loading'" x-transition.opacity.duration.250ms x-cloak>
							<div class="overflow-hidden rounded-lg border border-border bg-subtle p-4">
								<div class="relative mb-4 h-2 overflow-hidden rounded-full bg-slate-200">
									<div class="scan-line absolute inset-y-0 h-full w-1/2 rounded-full bg-accent/70"></div>
								</div>
								<div class="space-y-3">
									<div class="h-4 w-3/5 rounded bg-slate-200"></div>
									<div class="h-4 w-5/6 rounded bg-slate-200"></div>
									<div class="h-4 w-2/3 rounded bg-slate-200"></div>
								</div>
							</div>
							<p class="text-sm text-muted">Scanning DNS records and authentication policy...</p>
						</div>

						<div class="mt-6 space-y-5" x-show="state === 'rating'" x-transition.opacity.duration.300ms x-cloak>
							<div class="rounded-lg border border-fail/25 bg-fail/5 p-5">
								<div class="flex items-start justify-between gap-5">
									<div>
										<p class="text-sm font-medium text-muted" x-text="domain">yourdomain.com</p>
										<p class="mt-2 text-sm font-semibold text-fail">p=none detected</p>
									</div>
									<div class="text-right">
										<p class="text-sm font-medium text-muted">Security Score</p>
										<p class="mt-1 text-4xl font-semibold tracking-tight text-ink">40<span class="text-xl text-muted">/100</span></p>
									</div>
								</div>
								<div class="mt-5 grid gap-2 text-sm text-muted">
									<div class="flex items-center justify-between rounded-lg border border-border bg-white px-3 py-2"><span>DMARC policy</span><span class="font-semibold text-fail">Monitor only</span></div>
									<div class="flex items-center justify-between rounded-lg border border-border bg-white px-3 py-2"><span>SPF alignment</span><span class="font-semibold text-yellow">Partial</span></div>
									<div class="flex items-center justify-between rounded-lg border border-border bg-white px-3 py-2"><span>DKIM coverage</span><span class="font-semibold text-accent">Detected</span></div>
								</div>
							</div>

							<div class="rounded-lg border border-border bg-subtle p-4">
								<p class="text-sm font-semibold text-ink">Double opt-in required</p>
								<p class="mt-2 text-sm leading-6 text-muted">To prove this vulnerability, we just sent a verification link to your inbox. Click it to authorize a safe spoof demonstration.</p>
							</div>

							<div class="flex flex-col gap-3 sm:flex-row">
								<button type="button" x-on:click="state = 'input'; email = ''" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-border px-4 text-sm font-semibold text-ink transition hover:border-accent hover:text-accent">Run Another Check</button>
								<a href={ brand.BookingURL } class="inline-flex min-h-11 items-center justify-center rounded-lg bg-accent px-4 text-sm font-semibold text-white transition hover:bg-accent-hover">Book Implementation Call</a>
							</div>
						</div>
					</section>
				</section>

				<section class="border-y border-border bg-subtle">
					<div class="mx-auto grid max-w-7xl gap-5 px-5 py-16 sm:px-8 md:grid-cols-3 lg:px-10">
						@featureCard("Analyze", "We instantly scan your DMARC, SPF, and DKIM records for misconfigurations and drift.")
						@featureCard("Demonstrate", "With your permission, we safely bypass your filters to prove exactly how attackers can exploit your brand.")
						@featureCard("Remediate", "Dmark provides the exact DNS records needed to lock down your domain and ensure your outbound sales emails hit the inbox.")
					</div>
				</section>

				<section class="bg-ink">
					<div class="mx-auto grid max-w-7xl gap-8 px-5 py-16 text-white sm:px-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:px-10 lg:py-20">
						<h2 class="max-w-2xl text-4xl font-semibold tracking-tight sm:text-5xl">Why your emails are landing in Spam.</h2>
						<p class="max-w-3xl text-base leading-8 text-slate-300 sm:text-lg">Microsoft and Google now mandate strict DMARC enforcement. If your records are missing, misaligned, or drifting, your legitimate outbound emails are being penalized. Dmark translates complex XML reports into a clear signal.</p>
					</div>
				</section>

				<section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 lg:px-10 lg:py-20">
					<div class="max-w-3xl">
						<h2 class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Lock down your domain today.</h2>
						<p class="mt-5 text-lg leading-8 text-muted">The full Dmark automated dashboard is currently in private beta. Run the free diagnostic tool above, or book a 15-minute technical implementation call to fix your records immediately.</p>
						<a href={ brand.BookingURL } class="mt-8 inline-flex min-h-12 items-center rounded-lg bg-accent px-5 text-sm font-semibold text-white shadow-[0_4px_6px_-1px_rgba(0,0,0,0.05),0_2px_4px_-1px_rgba(0,0,0,0.03)] transition hover:bg-accent-hover focus:outline-none focus:ring-4 focus:ring-accent/20">Book Implementation Call</a>
					</div>
				</section>
			</main>
		</body>
	</html>
}

templ CheckResult(result scanner.Result, audit salesaudit.Result, csrfToken string) {
	<!doctype html>
	<html lang="en" class="bg-white text-ink">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ result.Domain } - Dmark Diagnostic</title>
			<meta name="description" content="Current public DNS, SPF, DKIM, DMARC, and BIMI posture."/>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<main class="mx-auto max-w-7xl px-5 py-6 sm:px-8 lg:px-10">
				<header class="flex items-center justify-between border-b border-border pb-5">
					@brandLockup("dmark", "Dmark home")
					<a class="font-mono text-xs uppercase tracking-[0.2em] text-yellow" href="/">New check</a>
				</header>

				<section class="space-y-8 py-12">
					<div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
						<div class="space-y-4">
							<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">Live trust audit</p>
							<h1 class="text-5xl font-semibold tracking-tight text-ink">{ result.Domain }</h1>
							<p class="max-w-2xl text-lg leading-8 text-muted">{ audit.Message }</p>
							<form method="post" action="/claim-audit" class="grid max-w-2xl gap-3 border border-border bg-card/90 p-2 sm:grid-cols-[1fr_auto]">
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<input type="hidden" name="domain" value={ result.Domain }/>
								<label class="sr-only" for="claim-email">Work email</label>
								<input id="claim-email" name="email" type="email" required class="min-h-14 bg-transparent px-4 font-mono text-base text-ink outline-none placeholder:text-muted/60" placeholder={ "you@" + result.Domain } autocomplete="email"/>
								<button type="submit" class="min-h-14 bg-accent px-6 font-mono text-sm font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-accent-hover">Claim audit</button>
							</form>
							<p class="max-w-2xl font-mono text-xs uppercase tracking-[0.18em] text-yellow">{ audit.CTA }</p>
						</div>
						<aside class="border border-border bg-card p-5" aria-label="Sales audit summary">
							<p class="font-mono text-xs uppercase tracking-[0.24em] text-muted">Audit grade</p>
							<div class="mt-4 flex items-end justify-between gap-4">
								<p class="text-6xl font-semibold tracking-tight text-ink">{ audit.Grade }</p>
								<p class={ "border px-3 py-2 font-mono text-xs uppercase tracking-[0.18em] " + auditRiskClass(audit.Risk) }>{ string(audit.Risk) } risk</p>
							</div>
							if audit.Safe {
								<p class="mt-5 text-sm leading-6 text-muted">DMARC enforcement is active. Keep this domain watched for sender and DNS drift.</p>
							} else {
								<p class="mt-5 text-sm leading-6 text-muted">DMARC is not enforcing yet. Dmark can turn this public check into a tracked remediation plan.</p>
							}
						</aside>
					</div>

					<div class="grid gap-4 md:grid-cols-4">
						@checkResultCard(result.SPF)
						@checkResultCard(result.DKIM)
						@checkResultCard(result.DMARC)
						@checkResultCard(result.BIMI)
					</div>
				</section>
			</main>
		</body>
	</html>
}

templ checkResultCard(check scanner.CheckResult) {
	<article class="border border-border bg-card p-5">
		<div class="flex items-center justify-between gap-3">
			<p class="font-mono text-sm font-semibold text-ink">{ check.Name }</p>
			<p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">{ string(check.Status) }</p>
		</div>
		<p class="mt-4 text-sm leading-6 text-muted">{ check.Message }</p>
		if check.Record != "" {
			<pre class="mt-4 overflow-x-auto whitespace-pre-wrap break-words border border-border bg-subtle p-4 text-xs leading-6 text-muted">{ check.Record }</pre>
		}
	</article>
}

templ Login(csrfToken string) {
	<!doctype html>
	<html lang="en" class="bg-white text-ink">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Sign in - { brand.FullProductName }</title>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<main class="mx-auto grid min-h-screen max-w-xl place-items-center px-5 py-12">
				<section class="w-full border border-border bg-card p-8">
					<a href="/" class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Dmark</a>
					<h1 class="mt-6 text-4xl font-semibold tracking-tight text-ink">Sign in with email</h1>
					<p class="mt-4 text-sm leading-6 text-muted">Enter your email and Dmark will send a one-time magic link.</p>
					<form method="post" action="/login" class="mt-8 grid gap-3">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<label class="sr-only" for="email">Email</label>
						<input id="email" name="email" type="email" required class="min-h-14 border border-border bg-subtle px-4 font-mono text-base text-ink outline-none placeholder:text-muted/60" placeholder="you@example.com" autocomplete="email"/>
						<button type="submit" class="min-h-14 bg-accent px-6 font-mono text-sm font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-accent-hover">Send magic link</button>
					</form>
				</section>
			</main>
		</body>
	</html>
}

templ LoginSent(email string) {
	<!doctype html>
	<html lang="en" class="bg-white text-ink">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Check your email - { brand.FullProductName }</title>
			<link rel="stylesheet" href="/assets/css/marketing-20260512.css"/>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<main class="mx-auto grid min-h-screen max-w-xl place-items-center px-5 py-12">
				<section class="w-full border border-border bg-card p-8">
					<p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">Magic link sent</p>
					<h1 class="mt-6 text-4xl font-semibold tracking-tight text-ink">Check your email</h1>
