# HTTP listen address for `meil serve`.
HTTP_ADDR=:8080

# Canonical public URL used in links and redirects.
PUBLIC_BASE_URL=http://localhost:8080

# Directory used to serve static assets.
ASSETS_DIR=assets

# Postgres connection used by future migrations and app storage.
DATABASE_URL=postgres://meil:meil@localhost:5432/meil?sslmode=disable

# Local SMTP settings for Mailpit in development.
SMTP_HOST=localhost
SMTP_PORT=1025

# Lettermint Sending API settings for passwordless login emails.
LETTERMINT_BASE_URL=https://api.lettermint.co/v1
LETTERMINT_TOKEN=
LETTERMINT_FROM=Meil <login@example.com>

# Magic-link lifetime in minutes.
AUTH_TOKEN_TTL_MINUTES=15
