# HTTP listen address for `meil serve`.
HTTP_ADDR=:8080

# Canonical public URL used in links, redirects, and metadata.
PUBLIC_BASE_URL=https://recordmaster.kastro.is

# Directory used to serve static assets.
ASSETS_DIR=assets

# Postgres connection used by future migrations and app storage.
DATABASE_URL=postgres://meil:meil@localhost:5432/meil?sslmode=disable

# ClickHouse HTTP connection used by Reporter aggregate migrations.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=meil
CLICKHOUSE_USER=meil
CLICKHOUSE_PASSWORD=meil

# Local SMTP settings for Mailpit in development.
SMTP_HOST=localhost
SMTP_PORT=1025

# Lettermint Sending API settings for passwordless login emails.
LETTERMINT_BASE_URL=https://api.lettermint.co/v1
LETTERMINT_TOKEN=
LETTERMINT_FROM=Kastro RecordMaster <login@example.com>

# Magic-link lifetime in minutes.
AUTH_TOKEN_TTL_MINUTES=15

# Billing webhook verification secret.
BILLING_WEBHOOK_SECRET=

# Abuse and public checker limits.
PUBLIC_CHECKS_PER_MINUTE=12

# Reporter ingestion limits.
DMARC_MAX_REPORT_BYTES=10485760


# Origin serving the free public workspace and email-link confirmation.
FRONTEND_BASE_URL=https://dmark.is
